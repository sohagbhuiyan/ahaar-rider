# Copy to .env.local and restart Metro (`npx expo start -c`) after changing.
# Defaults to the hosted API when unset, which works on a real phone in Expo Go.
EXPO_PUBLIC_API_URL=https://api.ahaar.store/api/v1

# Local backend: use your PC's LAN IP, never localhost (the phone can't see it).
# EXPO_PUBLIC_API_URL=http://192.168.0.151:8000/api/v1

# Build-time only (NOT EXPO_PUBLIC): Google Maps SDK for Android key, read by
# app.config.ts into the native project. Restrict it to package
# `store.ahaarrider` + the build's SHA-1. Without it the job/run screens show
# the addresses and a "Navigate" button instead of a map. For EAS builds:
#   eas env:create --name GOOGLE_MAPS_ANDROID_API_KEY --value ... 
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_MAPS_IOS_API_KEY=
