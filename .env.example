# Copy to .env.local and restart Metro (`npx expo start -c`) after changing.
# Defaults to the hosted API when unset, which works on a real phone in Expo Go.
EXPO_PUBLIC_API_URL=https://api.ahaar.store/api/v1

# Local backend: use your PC's LAN IP, never localhost (the phone can't see it).
# EXPO_PUBLIC_API_URL=http://192.168.0.151:8000/api/v1
